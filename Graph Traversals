#include <stdio.h>
#define MAX 10

int adj[MAX][MAX], visited[MAX];
int n;

// DFS Traversal
void DFS(int v) {
    printf("%d ", v);
    visited[v] = 1;

    for(int i = 0; i < n; i++) {
        if(adj[v][i] == 1 && visited[i] == 0) {
            DFS(i);
        }
    }
}
// BFS Traversal
void BFS(int start) {
    int queue[MAX], front = 0, rear = 0;

    printf("%d ", start);
    visited[start] = 1;
    queue[rear++] = start;

    while(front < rear) {
        int v = queue[front++];

        for(int i = 0; i < n; i++) {
            if(adj[v][i] == 1 && visited[i] == 0) {
                printf("%d ", i);
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }
}
int main() {
    int i, j, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }
 printf("Enter starting vertex: ");
    scanf("%d", &start);

    // DFS
    for(i = 0; i < n; i++)
        visited[i] = 0;

    printf("\nDFS Traversal: ");
    DFS(start);
// BFS
    for(i = 0; i < n; i++)
        visited[i] = 0;

    printf("\nBFS Traversal: ");
    BFS(start);

    return 0;
}
