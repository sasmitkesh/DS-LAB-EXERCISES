#include <stdio.h>
#include <stdlib.h>

// Structure of node
struct Node {
    int data;
    struct Node* next;
};
// Function to traverse and display the list
void traverse(struct Node* head) {
    struct Node* temp = head;

    printf("Linked List elements are:\n");
    while(temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
}
// Function to insert at beginning
struct Node* insertAtBeginning(struct Node* head, int value) {
    struct Node* newNode;

    newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;

    newNode->next = head;  // Link new node to previous head
    head = newNode;        // Move head to new node

    return head;
}
int main() {
    struct Node* head = NULL;
    int n, i, value;

    printf("Enter number of initial nodes: ");
    scanf("%d", &n);

    // Creating initial list
    for(i = 0; i < n; i++) {
        printf("Enter data: ");
        scanf("%d", &value);
        head = insertAtBeginning(head, value);
    }
printf("\nList after insertion at beginning:\n");
    traverse(head);

    return 0;
}
